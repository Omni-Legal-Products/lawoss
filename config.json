{
  "provider": {
    "eigenwelt": {
      "name": "Eigenwelt Model API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8080/v1"
      },
      "models": {
        "ewl-small": {
          "name": "EWL Small",
          "tool_call": true,
          "limit": {
