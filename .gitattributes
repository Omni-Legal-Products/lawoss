# LAWOSS: textové súbory vždy s LF, aj pri checkoute na Windows (runner
# windows-2022 má core.autocrlf=true). SKILL.md, prompty a bundle OKF sa do
# appky vkladajú doslova; s CRLF by build pre Windows mal iné prompty, iné
# odtlačky skillov a prázdne popisy z frontmatteru než build pre macOS.
* text=auto eol=lf
apps/app/public/third-party/** linguist-vendored
*.pdf binary

# Frozen test corpus: manifests bind original bytes, including MIME/CSV CRLF.
lawoss/testing/fixtures/cz-workflow-derived-v1/** -text whitespace=cr-at-eol
# Source-build provenance verifies these reviewed text bytes on every host.
packages/opencode-release/** text eol=lf
docs/patches/opencode-2.1.4-mcp-http-policy-v3.patch text eol=lf
docs/patches/opencode-2.1.4-mcp-http-policy-v3.receipt.json text eol=lf

# The browser generator reads the same reviewed source bytes on every host.
apps/desktop/electron/browser-native/** text eol=lf
